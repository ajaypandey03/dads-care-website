{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dadscare-mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd dadscare-mobile && npx expo start --web --port 8092"],
      "port": 8092
    },
    {
      "name": "dadscare-website",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd website && NEXT_PUBLIC_API_BASE_URL=http://localhost:8090 npm run dev -- --port 3000"],
      "port": 3000
    }
  ]
}
