# ── Database
# Ports below (3308/6381) match docker-compose.yml — deliberately non-default because
# 3306/6379 are already used by another local dev stack on this machine. Adjust both
# files together if you change them.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=dadscare
DB_USERNAME=dadscare
DB_PASSWORD=dadscare

# ── Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# ── JWT
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_TTL_MIN=60

# ── Webhook (Velosyss -> Dad's Care)
# Shared HMAC-SHA256 secret for the whole integration (see WebhookSignatureVerifier) —
# one secret for the platform, not per Organization.
WEBHOOK_VELOSYSS_SECRET=
WEBHOOK_MAX_SKEW_SEC=300

# ── Velosyss Enterprise API (Dad's Care -> Velosyss, LOCK/UNLOCK command relay)
# Leave blank until Velosyss ships LOCK/UNLOCK support and issues an API key — see
# "Velosyss-side prerequisites" in the Implementation Tracker. VelosyssCommandClient
# fails gracefully (logs + returns failure) when unconfigured, it doesn't crash startup.
VELOSYSS_API_BASE_URL=
VELOSYSS_API_KEY=

# ── CORS (browser clients only — website dashboard, Expo web target)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8092

SERVER_PORT=8090
