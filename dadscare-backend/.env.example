# ── Database
# Points at a local MySQL server on the default port. If you're running MySQL yourself
# (not via docker-compose.yml), create the DB/user once:
#   CREATE DATABASE dadscare;
#   CREATE USER 'dadscare'@'%' IDENTIFIED BY 'dadscare';
#   GRANT ALL PRIVILEGES ON dadscare.* TO 'dadscare'@'%';
# If 3306 is already taken by another local MySQL, either point this at that server's
# own "dadscare" DB/user (as above), or run docker-compose.yml's mysql service instead
# and change DB_PORT to whatever host port you map it to.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dadscare
DB_USERNAME=dadscare
DB_PASSWORD=dadscare

# ── Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# ── JWT
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_TTL_MIN=60

# ── Webhook (Velosyss -> Dad's Care)
# Give Velosyss the HTTPS URL of this backend's /api/v1/webhooks/velosyss/lock-events
# endpoint; they'll issue this shared HMAC-SHA256 secret in return (see
# WebhookSignatureVerifier — verifies the X-Velosyss-Signature header, §4.3 of the
# Integration Guide). One secret for the whole platform, not per Organization.
WEBHOOK_VELOSYSS_SECRET=
WEBHOOK_MAX_SKEW_SEC=300

# ── Velosyss Partner Integration API (Dad's Care -> Velosyss)
# Base URL defaults to the real one (https://velosyss.com/api/v1) — only the API key
# needs setting, from Velosyss's web app under Settings -> API Keys (needs READ_DEVICES,
# READ_POSITIONS, and WRITE_LOCK_COMMANDS scopes). Blank key = both VelosyssCommandClient
# and VelosyssReadClient log and no-op rather than throwing, so the app still runs without
# live lock control until a key is set.
VELOSYSS_API_BASE_URL=https://velosyss.com/api/v1
VELOSYSS_API_KEY=
# Reconciliation poll intervals (ms) — see VelosyssPollingService.
VELOSYSS_POSITIONS_POLL_MS=20000
VELOSYSS_EVENTS_POLL_MS=180000

# ── CORS (browser clients only — website dashboard, Expo web target)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8092

SERVER_PORT=8090
